<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_gradient"
    android:clipChildren="false"
    tools:context=".AlarmActivity">

    <!-- Video alarm layer (only visible in video mode) -->
    <TextureView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/scrimTop"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top"
        android:visibility="gone" />

    <View
        android:id="@+id/scrimBottom"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"
        android:visibility="gone" />

    <!-- Pulse rings behind the time -->
    <View
        android:id="@+id/pulseRing1"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="150dp"
        android:background="@drawable/pulse_ring" />

    <View
        android:id="@+id/pulseRing2"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="150dp"
        android:background="@drawable/pulse_ring" />

    <!-- Time + date, centered over rings -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="150dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:text="5:41"
                android:textColor="#FFFFFF"
                android:textSize="76sp" />

            <TextView
                android:id="@+id/ampmTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-light"
                android:text="PM"
                android:textColor="#B3FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05"
            android:text="Tuesday, 25 November"
            android:textColor="#8CFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/labelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="32dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:textColor="#E6FFFFFF"
            android:textSize="20sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Snooze targets: drag the pill down onto 5 / 10 / 15 (hidden for the timer) -->
    <LinearLayout
        android:id="@+id/snoozeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="40dp"
        android:alpha="0.45"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/snooze5"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/snooze_target"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light" android:text="5" android:textColor="#FFFFFF" android:textSize="22sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="min" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/snooze10"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="36dp"
            android:background="@drawable/snooze_target"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light" android:text="10" android:textColor="#FFFFFF" android:textSize="22sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="min" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/snooze15"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/snooze_target"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light" android:text="15" android:textColor="#FFFFFF" android:textSize="22sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="min" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Swipe-up hint + pill -->
    <LinearLayout
        android:id="@+id/pillBlock"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="160dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/swipeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:text="Swipe up to turn off · down to snooze"
            android:textColor="#80FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/dismissPill"
            android:layout_width="200dp"
            android:layout_height="72dp"
            android:background="@drawable/pill_swipe"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="︿"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.1"
                android:text="OFF"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
